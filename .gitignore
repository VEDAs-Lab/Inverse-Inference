cat > .gitignore << 'EOF'
# ========================================
# SLIMIA-IPP .gitignore (Recommended)
# ========================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/
*.env

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints/
__pycache__/

# Data & Large files (track only small metadata)
data/*.zip
data/*.tar
data/*.gz
data/*.tiff
data/*.tif
data/raw/
data/interim/

# ML Outputs - Heavy files
checkpoints/
checkpoints/**/*
*.pth
*.pt
*.h5
*.onnx
*.bin

# Results - Figures are usually large
results/figures/
results/*/figures/
figures/
images/
*.png
*.jpg
*.jpeg
*.tiff
*.tif
*.pdf

# But allow important small figures for README/paper
!results/figures/key_*.png
!results/figures/main_*.png
!results/figures/comparison*.png
!paper/figures/
!docs/images/

# Track metadata CSVs (unignore specific files)
data/slimia_metadata.csv
data/slimia_metadata_with_morphology.csv
!data/*.csv

# OS files
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
logs/

# Optional: IDE files
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.temp
EOF